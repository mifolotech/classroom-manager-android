<?xml version="1.0" encoding="utf-8"?>

<!-- gravity start : la bulle se place à GAUCHE. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingBottom="3dp"
    android:paddingTop="3dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="56dp"
        android:background="@drawable/bulle_recu"
        android:orientation="vertical"
        android:paddingBottom="9dp"
        android:paddingEnd="14dp"
        android:paddingStart="14dp"
        android:paddingTop="9dp">

        <ImageView
            android:id="@+id/ivApercu"
            android:layout_width="@dimen/apercu_largeur"
            android:layout_height="@dimen/apercu_hauteur"
            android:layout_marginBottom="8dp"
            android:background="@drawable/fond_apercu"
            android:clipToOutline="true"
            android:contentDescription="@string/apercu_description"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvContenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvPieceJointe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/primaire"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textColor="@color/texte_secondaire"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>