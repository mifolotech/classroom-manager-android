<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_ecran"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ===== BANNIÈRE + bouton d'apparence posé par-dessus ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fond_hero"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="28dp"
                android:paddingEnd="24dp"
                android:paddingStart="24dp"
                android:paddingTop="32dp">

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:contentDescription="@string/splash_logo_description"
                    android:src="@drawable/logo_gestionclasse" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/role_titre"
                    android:textColor="@android:color/white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="44dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/trait_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/role_sous_titre"
                    android:textColor="#D9FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- NOUVEAU (11.6) : bouton rond d'apparence (48dp : zone tactile confortable). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTheme"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:clickable="true"
                android:contentDescription="@string/theme_titre"
                android:focusable="true"
                app:cardBackgroundColor="#33FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_theme"
                    app:tint="@android:color/white" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- ===== CARTE ENSEIGNANT (cliquable) ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnEnseignant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/contour"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/cercle_icone"
                    android:contentDescription="@null"
                    android:padding="13dp"
                    android:src="@drawable/ic_enseignant"
                    app:backgroundTint="@color/accent_orange"
                    app:tint="@color/sur_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_enseignant"
                        android:textColor="@color/texte_principal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/role_enseignant_desc"
                        android:textColor="@color/texte_secondaire"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/symbole_chevron"
                    android:textColor="@color/texte_secondaire"
                    android:textSize="30sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== CARTE ÉTUDIANT (cliquable) ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnEtudiant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/contour"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/cercle_icone"
                    android:contentDescription="@null"
                    android:padding="13dp"
                    android:src="@drawable/ic_etudiant"
                    app:backgroundTint="@color/accent_vert"
                    app:tint="@color/sur_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/role_etudiant"
                        android:textColor="@color/texte_principal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/role_etudiant_desc"
                        android:textColor="@color/texte_secondaire"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/symbole_chevron"
                    android:textColor="@color/texte_secondaire"
                    android:textSize="30sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>