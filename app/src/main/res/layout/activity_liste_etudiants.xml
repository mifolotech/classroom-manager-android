<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_ecran"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ===== BANNIÈRE : titre (selon le mode) et compteur ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fond_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvTitreListe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/etudiants_titre"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- "3 étudiants", rempli par le Java. -->
        <TextView
            android:id="@+id/tvCompteur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/fond_puce_hero"
            android:paddingBottom="6dp"
            android:paddingEnd="14dp"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== RECHERCHE et TRI ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Champ de recherche : la liste se filtre à chaque lettre tapée. -->
        <EditText
            android:id="@+id/etRecherche"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/champ_arrondi"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_recherche"
            android:drawableTint="@color/texte_secondaire"
            android:hint="@string/indice_recherche"
            android:inputType="text"
            android:maxLength="50"
            android:maxLines="1"
            android:padding="14dp" />

        <!-- Le texte ("Tri : A → Z" ou "Tri : Z → A") est défini par le Java. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTri"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/tri_croissant"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/contour" />
    </LinearLayout>

    <!-- ===== AJOUTER et PARTAGER : enseignant seulement (le Java les rend visibles) =====
       Les deux boutons ont la MÊME hauteur fixe : leur taille est identique, même si un texte passe sur 2 lignes. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAjouter"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:maxLines="2"
            android:paddingEnd="8dp"
            android:paddingStart="8dp"
            android:text="@string/action_ajouter_etudiant"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/accent_vert"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPartager"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:maxLines="2"
            android:paddingEnd="8dp"
            android:paddingStart="8dp"
            android:text="@string/action_partager"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/primaire"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- ===== LA LISTE, dans une carte. Les lignes sont séparées par les traits du RecyclerView. ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="22dp"
        app:cardElevation="3dp"
        app:strokeColor="@color/contour"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEtudiants"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Message affiché à la place de la liste quand elle est vide : icône, puis texte. -->
            <TextView
                android:id="@+id/tvVide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="14dp"
                android:drawableTint="@color/texte_secondaire"
                android:drawableTop="@drawable/ic_etudiants"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/etudiants_vide"
                android:textColor="@color/texte_secondaire"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetour"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="14dp"
        android:text="@string/action_retour"
        android:textAllCaps="false"
        android:textColor="@color/primaire"
        app:cornerRadius="18dp"
        app:strokeColor="@color/contour" />

</LinearLayout>